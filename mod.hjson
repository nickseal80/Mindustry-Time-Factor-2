#the mod name as displayed in-game
displayName: "Time Factor 2"

#the internal name of your mod
name: "time-factor 2"

#your name
author: "Seal"

#the fully qualified main class of the mod
main: "org.seal.mindustry.timeFactor.TimeFactor"

repo: "https://github.com/nickseal80/Mindustry-Time-Factor-2"

#the mod description as seen in the mod dialog
description: "Real-time speed control for Mindustry. Customize speed limits and reset instantly with a clean UI."

#the mod version
version: 1.0

#the minimum game build required to run this mod
minGameVersion: 154

#this is a java mod
java: true
